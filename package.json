{
  "name": "repttyl",
  "version": "0.1.2-rc.5",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "scripts/typecheck-lint.sh",
    "typecheck:ts": "pnpm --filter @repttyl/protocol-client typecheck && pnpm --filter @repttyl/client-node typecheck && pnpm --filter @repttyl/cli typecheck && pnpm --filter @repttyl/desktop typecheck",
    "typecheck:go": "cd agent && test -z \"$(gofmt -l ./cmd ./internal)\" && go test -count=1 ./...",
    "verify": "pnpm typecheck && pnpm test",
    "release:preflight": "pnpm typecheck && pnpm --filter @repttyl/cli build && pnpm --filter @repttyl/desktop package && cd agent && go test -count=1 ./... && go build -o bin/repttyl ./cmd/repttyl",
    "agent:build": "nx build agent",
    "agent:test": "nx test agent",
    "cli:build": "nx build cli",
    "desktop:start": "nx start desktop",
    "desktop:start-vnc": "pnpm --filter @repttyl/desktop start:vnc",
    "desktop:start-vnc-devtools": "pnpm --filter @repttyl/desktop start:vnc:devtools"
  },
  "devDependencies": {
    "@nx/js": "^22.0.0",
    "@types/node": "^24.0.0",
    "nx": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "fs-xattr",
      "macos-alias",
      "nx"
    ]
  }
}
