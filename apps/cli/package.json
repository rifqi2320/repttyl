{
  "name": "@repttyl/cli",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "repttyl-client": "./dist/main.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm --filter @repttyl/client-node build && tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@repttyl/client-node": "workspace:*",
    "@repttyl/protocol-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
