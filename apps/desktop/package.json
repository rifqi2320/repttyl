{
  "name": "@repttyl/desktop",
  "version": "0.1.2-rc.5",
  "productName": "Repttyl",
  "license": "MIT",
  "private": true,
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "start:vnc": "DISPLAY=${DISPLAY:-:99} ELECTRON_DISABLE_SANDBOX=1 REPTTYL_VNC=1 electron-forge start",
    "start:vnc:devtools": "DISPLAY=${DISPLAY:-:99} ELECTRON_DISABLE_SANDBOX=1 REPTTYL_VNC=1 REPTTYL_OPEN_DEVTOOLS=1 electron-forge start",
    "typecheck": "pnpm --filter @repttyl/client-node build && tsc -p tsconfig.json --noEmit",
    "package": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && pnpm --filter @repttyl/client-node build && electron-forge package",
    "make": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && pnpm --filter @repttyl/client-node build && electron-forge make"
  },
  "dependencies": {
    "@repttyl/client-node": "workspace:*",
    "@repttyl/protocol-client": "workspace:*",
    "@xterm/xterm": "^5.5.0",
    "debug": "^2.6.9",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.0",
    "@electron-forge/maker-deb": "^7.10.0",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.10.0",
    "@electron-forge/maker-squirrel": "^7.10.0",
    "@electron-forge/maker-zip": "^7.10.0",
    "@electron-forge/plugin-webpack": "^7.10.0",
    "css-loader": "^7.1.0",
    "electron": "^39.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.9.0"
  }
}
