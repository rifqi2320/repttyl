{
  "name": "desktop",
  "root": "apps/desktop",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @repttyl/desktop start"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @repttyl/desktop package"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @repttyl/desktop typecheck"
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @repttyl/desktop make"
      }
    }
  }
}
