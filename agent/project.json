{
  "name": "agent",
  "root": "agent",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o bin/repttyl ./cmd/repttyl",
        "cwd": "agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "agent"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gofmt -w ./cmd ./internal",
        "cwd": "agent"
      }
    }
  }
}

