{
  "name": "@repttyl/client-node",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm --filter @repttyl/protocol-client build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @repttyl/protocol-client build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repttyl/protocol-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
